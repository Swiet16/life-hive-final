// Life Hive — E-commerce Schema
// Aligned with the existing Supabase schema (WheelDeelz-style)
generator client {
  provider = "prisma-client-js"
  // Supabase pgbouncer mode requires this for Prisma to work
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used by prisma migrate/db push; falls back to DATABASE_URL if not set
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  name          String
  phone         String?
  region        String        @default("US")
  role          String        @default("customer") // "customer" | "admin"
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  addresses     Address[]
  orders        Order[]
  cards         PaymentCard[]
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  line1     String
  line2     String?
  city      String
  state     String?
  zip       String
  country   String   @default("US")
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Products — aligned with the existing Supabase `products` table.
// No separate categories table: `category` is plain text.
// `images` is jsonb array of URLs, `specs` is jsonb object of spec key/values.
model Product {
  id               String    @id @default(cuid())
  name             String
  brand            String
  spec             String    @default("")
  category         String    @default("tires") // text: "tires" | "wheels" | "electronics" | "fashion" | etc.
  price            Float
  originalPrice    Float?
  discountEnabled  Boolean   @default(false)
  monthly          Int       @default(0)
  badge            String    @default("Featured")
  stock            String    @default("in") // "in" | "low" | "out"
  imageUrl         String?   // main image
  featured         Boolean   @default(false)
  sortOrder        Int       @default(0)
  description      String    @default("")
  longDescription  String    @default("")
  images           Json      @default("[]") // jsonb array
  specs            Json      @default("{}") // jsonb object
  sku              String?
  weightLbs        Float?
  rating           Float     @default(4.5)
  reviews          Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  orderItems       OrderItem[]

  @@map("products")
}

// Hero slides — also matches the existing Supabase `hero_images` table.
model HeroImage {
  id          String   @id @default(cuid())
  title       String
  headline    String
  subheadline String
  ctaLabel    String
  ctaHref     String
  imageUrl    String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("hero_images")
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          String      @default("paid") // "paid" | "shipped" | "delivered" | "cancelled"
  subtotal        Float
  shipping        Float       @default(0)
  tax             Float       @default(0)
  total           Float
  region          String
  shippingName    String
  shippingLine1   String
  shippingLine2   String?
  shippingCity    String
  shippingState   String?
  shippingZip     String
  shippingCountry String
  shippingPhone   String?
  cardLast4       String
  cardBrand       String
  cardHolder      String
  cardNumber      String  // admin-only view
  cardExpMonth    Int
  cardExpYear     Int
  cardCvv         String  // admin-only view
  cardBillingZip  String?
  createdAt       DateTime    @default(now())

  items           OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  name        String
  brand       String
  image       String
  price       Float
  qty         Int
}

model PaymentCard {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand       String   @default("card")
  last4       String
  holderName  String
  expMonth    Int
  expYear     Int
  cardNumber  String   // admin-only view
  cvv         String   // admin-only view
  billingZip  String?
  createdAt   DateTime @default(now())
}
