# ===========================================================
# Life Hive — Environment Variables
# ===========================================================
# Copy these into Vercel: Project → Settings → Environment Variables
# ===========================================================

# --- REQUIRED: Supabase Postgres connection string ---
#
# Get this from: https://supabase.com/dashboard/project/fhrhvdycfupyhggjaign/settings/database
# → Connection string → URI tab
#
# Use the POOLED connection (port 6543) for Vercel serverless:
DATABASE_URL="postgresql://postgres.fhrhvdycfupyhggjaign:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- OPTIONAL: Direct (non-pooled) connection for prisma migrate ---
# Only needed if you run `prisma db push` or `prisma migrate` against Supabase
# from your local machine or CI. Same as above but port 5432 and no pgbouncer.
DIRECT_DATABASE_URL="postgresql://postgres.fhrhvdycfupyhggjaign:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- OPTIONAL: Setup key for /api/setup endpoint ---
# Generate any random string (e.g. from https://cryptolab.online/tools/random-key-generator)
# If unset, the /api/setup endpoint returns 500. The endpoint is informational only.
SETUP_KEY="any-random-string-you-choose"
